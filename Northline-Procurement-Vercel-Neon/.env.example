# Copy this file to .env and fill in real values for local development against Neon.
# Without DATABASE_URL, the app falls back to a local PGLite database automatically.

# Neon pooled or direct Postgres connection string (include ?sslmode=require)
DATABASE_URL=

# Your deployed URL in production, e.g. https://procurementsystemnorthline.vercel.app/
# Leave unset locally to use http://localhost:8080
BETTER_AUTH_URL=

# A long random secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
